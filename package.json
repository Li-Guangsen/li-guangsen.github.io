{
  "name": "sethli-personal-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "content:build": "velite build --strict",
    "content:watch": "velite dev --strict",
    "github:refresh": "node scripts/refresh-github-activity.mjs",
    "build": "npm run github:refresh && npm run content:build && next build",
    "typecheck": "npm run content:build && next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node --test tests/browser.test.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "canvas-confetti": "1.9.4",
    "hast-util-to-text": "4.0.2",
    "katex": "0.16.47",
    "motion": "14.4.0",
    "next": "16.4.0",
    "playwright": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-mermaid": "3.0.0",
    "rehype-pretty-code": "0.14.1",
    "rehype-slug": "6.0.0",
    "remark-gemoji": "8.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "3.21.0",
    "unist-util-visit": "5.1.0",
    "velite": "0.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
