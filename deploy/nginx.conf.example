# HTTP server block for example.com; HTTPS will be configured after DNS is ready.
# Serve the CONTENTS of out/ from /var/www/personal-site/current.
# Use your existing HTTPS/certificate management for this domain.
server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    root /var/www/personal-site/current;
    index index.html;
    charset utf-8;

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~ \.html$ {
        add_header Cache-Control "no-cache";
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
